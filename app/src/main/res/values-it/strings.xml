    <!-- Per-app list -->
    <string name="title_per_app">Rotazioni per app</string>
    <string name="per_app_empty">Nessuna lista per app. Usa Cambia qui sopra per dare a un\'app i suoi suoni o per disattivare la rotazione solo per lei. RoTone impara le app dalle loro notifiche: non c\'è niente da digitare.</string>
