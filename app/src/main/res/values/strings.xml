    <!-- How it works -->
    <string name="title_how_it_works">How it works</string>
    <string name="hint_app_scope">This list belongs to one app. Notifications from it use these sounds, and its own pointer advances independently of the default list.</string>
    <string name="hint_fallback_scope">This list is the fallback: every app without its own rotation uses it, and it has its own pointer.</string>
    <string name="hint_android">Android does not let one app change another app\'s notification sound, so RoTone plays the tone itself each time a notification arrives.</string>
    <string name="hint_silent">Set the apps you cover to Silent once, and you will hear only the rotating tone.</string>
    <string name="hint_dnd">Silent, vibrate and Do Not Disturb stay quiet: the pointer only moves when a tone actually plays.</string>
    <string name="hint_copies">Every picked sound is copied into the app, so it keeps working if the original is deleted.</string>

